    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sava/config": "workspace:*",
    "@types/react": "^19",
    "jsdom": "^29.0.0",
    "typescript": "^5",
    "vitest": "^4.1.0"

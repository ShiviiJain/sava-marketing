{
  "name": "sava-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter @sava/marketing dev",
    "build": "bun --filter @sava/marketing build",
    "start": "bun --filter @sava/marketing start",
    "lint": "bun --filter @sava/marketing lint",
    "typecheck": "bun --filter '*' typecheck",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
